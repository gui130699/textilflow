{
  "firestore": {
    "database": "(default)",
    "location": "southamerica-east1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "auth": {
    "providers": {
      "emailPassword": true
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "textilflow",
      "ignore": ["node_modules", ".git", "*-debug.log"],
      "predeploy": ["npm --prefix functions run build"]
    }
  ],
  "apphosting": {
    "backendId": "textilflow",
    "rootDir": "/",
    "ignore": [
      "node_modules",
      ".git",
      ".next",
      "functions/node_modules",
      "functions/lib",
      "tests",
      ".env*",
      "*-debug.log",
      ".emulator-credentials.json",
      "test-results",
      "playwright-report",
      "*-preview.png",
      ".audit-*.json"
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
