{
  "hosting": {
    "site": "textilflow-gui130699",
    "public": "out",
    "cleanUrls": true,
    "ignore": ["**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "no-referrer" },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          }
        ]
      },
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "firestore": {
    "database": "(default)",
    "location": "southamerica-east1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "auth": {
    "providers": {
      "emailPassword": true
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "textilflow",
      "ignore": ["node_modules", ".git", "*-debug.log"],
      "predeploy": ["npm --prefix functions run build"]
    }
  ],
  "apphosting": {
    "backendId": "textilflow",
    "rootDir": "/",
    "ignore": [
      "node_modules",
      ".git",
      ".next",
      "functions/node_modules",
      "functions/lib",
      "tests",
      ".env*",
      "*-debug.log",
      ".emulator-credentials.json",
      "test-results",
      "playwright-report",
      "*-preview.png",
      ".audit-*.json"
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
