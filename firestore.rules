// Data model: all operational records live under companies/{companyId}.
// companies: active:boolean, name:string, companyId:string, audit timestamps.
// members: role:'inspector'|'owner', active:boolean. Only trusted backend writes.
// projects: planned/cut integers, balances map, stages, audit fields.
// operational children: immutable events and backend-maintained balances.
// attachments: ownerVisible:boolean, path:string, contentType, size, createdAt.
// users: private profile. users/{uid}/companies: backend membership discovery.
// No client writes are allowed. Domain validation is enforced in Cloud Functions.
// Queries are scoped to a company/project; owners filter ownerVisible attachments.
rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function isOwner(uid){return signedIn() && request.auth.uid == uid;}
  function companyExists(c){return exists(/databases/$(database)/documents/companies/$(c));}
  function member(c){return signedIn() && companyExists(c) && get(/databases/$(database)/documents/companies/$(c)).data.active == true && exists(/databases/$(database)/documents/companies/$(c)/members/$(request.auth.uid)) && get(/databases/$(database)/documents/companies/$(c)/members/$(request.auth.uid)).data.active == true;}
  function inspector(c){return member(c) && get(/databases/$(database)/documents/companies/$(c)/members/$(request.auth.uid)).data.role == 'inspector';}
  function projectExists(c,p){return exists(/databases/$(database)/documents/companies/$(c)/projects/$(p));}
  function catalog(k){return k in ['clients','thirdParties','suppliers','materials','products','models','colors','sizes','grades','units','rejectionReasons','inspectionTypes','modules','categories'];}
  function event(k){return k in ['materialReceipts','inspections','modeling','productionMovements','productionBalances','activityLog','reversals'];}
  match /users/{uid} {
   allow read: if isOwner(uid);
   allow write: if false;
   match /companies/{companyId} {allow read: if isOwner(uid);allow write: if false;}
  }
  match /companies/{companyId} {
   allow read: if member(companyId);
   allow write: if false;
   match /members/{uid} {allow read: if inspector(companyId) || (member(companyId) && isOwner(uid));allow write: if false;}
   match /assets/{assetId} {allow read: if member(companyId);allow write: if false;}
   match /{kind}/{recordId} {allow read: if catalog(kind) && member(companyId);allow write: if false;}
   match /activityLog/{logId} {allow read: if inspector(companyId);allow write: if false;}
   match /projects/{projectId} {
    allow read: if member(companyId);
    allow write: if false;
    match /{kind}/{recordId} {allow read: if event(kind) && member(companyId) && projectExists(companyId,projectId);allow write: if false;}
    match /attachments/{attachmentId} {allow read: if member(companyId) && projectExists(companyId,projectId) && (inspector(companyId) || resource.data.ownerVisible == true);allow write: if false;}
   }
  }
  match /{document=**} {allow read,write: if false;}
 }
}
